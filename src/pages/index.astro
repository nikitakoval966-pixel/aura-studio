<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>

<script is:inline>
(function(){
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 1. КУРСОР ТА СЛІД (CANVAS) */
  const cursor = document.getElementById('cursor');
  const canvas = document.getElementById('trailCanvas');
  const ctx = canvas ? canvas.getContext('2d') : null;
  const globalGrid = document.getElementById('globalGrid');
  
  let mouse = { x: -100, y: -100 }; 
  let pos = { x: -100, y: -100 };
  let trailPoints = [];

  function resizeCanvas() {
    if(!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  window.addEventListener('mousemove', e => {
    mouse.x = e.clientX; 
    mouse.y = e.clientY;
    
    trailPoints.push({ x: e.clientX, y: e.clientY, age: 0, maxAge: 60 });

    if (globalGrid) {
      const maskStr = `radial-gradient(circle 400px at ${e.clientX}px ${e.clientY}px, black 0%, transparent 100%)`;
      globalGrid.style.webkitMaskImage = maskStr;
      globalGrid.style.maskImage = maskStr;
    }
  });

  (function loop(){
    pos.x += (mouse.x - pos.x) * 0.2; 
    pos.y += (mouse.y - pos.y) * 0.2;
    cursor.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) translate(-50%, -50%)`;

    if (ctx && canvas && !reduceMotion) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const rgb = isDark ? '41, 151, 255' : '0, 113, 227';

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (let i = 1; i < trailPoints.length; i++) {
        const p0 = trailPoints[i - 1];
        const p1 = trailPoints[i];
        p1.age += 1;
        const life = 1 - (p1.age / p1.maxAge);

        if (life > 0) {
          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.lineTo(p1.x, p1.y);
          ctx.lineWidth = 14 * life;
          ctx.strokeStyle = `rgba(${rgb}, ${life * 0.6})`;
          ctx.shadowBlur = 12;
          ctx.shadowColor = `rgba(${rgb}, ${life})`;
          ctx.stroke();
        }
      }
      trailPoints = trailPoints.filter(p => p.age < p.maxAge);
    }
    requestAnimationFrame(loop);
  })();

  document.querySelectorAll('.hover-target').forEach(el => {
    el.addEventListener('mouseenter', () => { cursor.classList.add('grow'); });
    el.addEventListener('mouseleave', () => { cursor.classList.remove('grow'); });
  });

  /* 2. ВІДЖЕТ ЧАСУ ТА ДАТИ */
  function updateLiveClock() {
    const now = new Date();
    const timeEl = document.getElementById('liveTime');
    const dateEl = document.getElementById('liveDate');
    
    if(timeEl) {
      timeEl.textContent = now.toLocaleTimeString('uk-UA', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    if(dateEl) {
      dateEl.textContent = now.toLocaleDateString('uk-UA', { timeZone: 'Europe/Kyiv', day: 'numeric', month: 'long', year: 'numeric' });
    }
  }
  setInterval(updateLiveClock, 1000);
  updateLiveClock();

  /* 3. ШТОРКА ЗМІНИ ТЕМИ */
  document.getElementById('year').textContent = new Date().getFullYear();
  const themeToggle = document.getElementById('themeToggle');
  const html = document.documentElement;
  
  const updateToggleIcon = () => { 
    themeToggle.textContent = html.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙'; 
  };
  updateToggleIcon();

  themeToggle.addEventListener('click', () => {
    const isDark = html.getAttribute('data-theme') === 'dark';
    const newTheme = isDark ? 'light' : 'dark';
    const wipe = document.getElementById('themeWipe');

    if(wipe) {
      wipe.style.background = isDark ? '#F5F5F7' : '#000000';
      wipe.style.transition = 'transform 0.6s cubic-bezier(0.76, 0, 0.24, 1)';
      wipe.style.transform = 'translateY(0)'; 

      setTimeout(() => {
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateToggleIcon();

        wipe.style.transform = 'translateY(100%)';

        setTimeout(() => {
          wipe.style.transition = 'none';
          wipe.style.transform = 'translateY(-100%)';
        }, 600);
      }, 600);
    } else {
      html.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateToggleIcon();
    }
  });

  /* 4. GSAP АНІМАЦІЇ */
  const countEl = document.getElementById('loaderCount');
  const brandEl = document.getElementById('loaderBrand');
  const preloader = document.getElementById('preloader');
  const siteContainer = document.getElementById('siteContainer');

  function runHeroEntrance() {
    if(reduceMotion || typeof gsap === 'undefined') {
      const hw = document.getElementById('heroWidget');
      const ht = document.getElementById('heroTitle');
      if (hw) { hw.style.opacity = 1; hw.style.transform = 'none'; }
      if (ht) { ht.style.opacity = 1; ht.style.transform = 'none'; }
      return;
    }
    
    // Анімуємо текст і віджет після завантаження
    const tl = gsap.timeline({ defaults:{ ease:'power3.out' } });
    
    tl.fromTo('#heroTitle', {opacity: 0, y: 30}, { opacity: 1, y: 0, duration: 1.2 }, "+=0.2")
      .fromTo('.hero .sub', {opacity: 0, y: 20}, { opacity: 1, y: 0, duration: 1 }, '-=0.8');

    const hw = document.getElementById('heroWidget');
    if (hw) tl.to(hw, { opacity: 1, y: 0, scale: 1, duration: 1 }, '-=0.8');
  }

  function triggerZoomReveal() {
    if(reduceMotion || typeof gsap === 'undefined') {
      preloader.style.display = 'none';
      siteContainer.style.visibility = 'visible';
      siteContainer.style.opacity = 1;
      siteContainer.style.transform = 'none';
      document.body.style.overflow = '';
      runHeroEntrance();
      return;
    }

    const tl = gsap.timeline({
      onComplete: () => {
        preloader.style.display = 'none';
        document.body.style.overflow = '';
        runHeroEntrance();
      }
    });

    tl.to(countEl, { opacity: 0, duration: 0.2, ease: "power2.out" }, 0);
    tl.to('.preloader-glow', { opacity: 0, duration: 0.3 }, 0); // Ховаємо світіння
    tl.to(brandEl, { scale: 0.9, duration: 0.3, ease: "power2.out" }, "+=0.1");

    tl.to(brandEl, {
      scale: 120, 
      opacity: 0, 
      filter: 'blur(10px)', 
      duration: 0.8,
      ease: "power4.in" 
    }, "+=0.1");

    tl.set(siteContainer, { visibility: 'visible' }, "-=0.6");
    tl.to(siteContainer, { opacity: 1, scale: 1, duration: 0.8, ease: "power3.out" }, "-=0.6");
    tl.set(siteContainer, { clearProps: "transform" }); 
    tl.to(preloader, { opacity: 0, duration: 0.4 }, "-=0.4");
  }

  /* 5. LENIS ПЛАВНИЙ СКРОЛ */
  try {
    if (typeof gsap === 'undefined') throw new Error('GSAP is not loaded');
    gsap.registerPlugin(ScrollTrigger);

    document.body.style.overflow = 'hidden';

    // Початково приховуємо заголовок, щоб він плавно з'явився
    gsap.set('#heroTitle, .hero .sub', { opacity: 0, y: 30 });

    let obj = { val: 0 };
    gsap.to(obj, {
      val: 100,
      duration: 1.5,
      ease: "power1.inOut",
      onUpdate: () => {
        if(countEl) countEl.textContent = Math.floor(obj.val).toString().padStart(3, '0') + '%';
      },
      onComplete: triggerZoomReveal
    });

    if(!reduceMotion){
      gsap.utils.toArray('.reveal-slow').forEach(function(elem) {
        if(elem.id === 'heroWidget' || elem.id === 'heroTitle' || elem.classList.contains('sub')) return;
        gsap.set(elem, { autoAlpha: 0, y: 30 });
        gsap.to(elem, {
          scrollTrigger: { trigger: elem, start: "top 85%", once: true },
          autoAlpha: 1, y: 0, duration: 1.5, ease: "power2.out"
        });
      });
    }

    if (typeof Lenis !== 'undefined' && !reduceMotion) {
      window.lenis = new Lenis({ 
        duration: 1.6, 
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
        smoothWheel: true 
      });
      function raf(time){ window.lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);
      ScrollTrigger.update();
      gsap.ticker.add((time)=> window.lenis.raf(time*1000));
      gsap.ticker.lagSmoothing(0);
    }

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetID = this.getAttribute('href');
        const targetElement = document.querySelector(targetID);
        
        if (window.lenis) {
          const isTop = targetID === '#top';
          window.lenis.scrollTo(isTop ? 0 : targetElement, { 
            duration: isTop ? 3.5 : 1.5,
            easing: (t) => 1 - Math.pow(1 - t, 4) 
          });
        } else if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

  } catch (e) {
    console.error('Effects failed, falling back:', e);
    if(preloader) preloader.style.display = 'none';
    if(siteContainer) {
      siteContainer.style.visibility = 'visible';
      siteContainer.style.opacity = 1;
      siteContainer.style.transform = 'none';
    }
    document.body.style.overflow = '';
  }

  /* 6. КНОПКА "ВГОРУ" */
  const backToTopBtn = document.getElementById('backToTopBtn');
  const heroEl = document.getElementById('hero');

  function toggleBackToTop() {
    if(!backToTopBtn) return;
    const scrolled = window.scrollY || document.documentElement.scrollTop;
    const threshold = heroEl ? heroEl.offsetHeight * 0.6 : 400;
    if (scrolled > threshold) {
      backToTopBtn.classList.add('visible');
    } else {
      backToTopBtn.classList.remove('visible');
    }
  }

  window.addEventListener('scroll', toggleBackToTop, { passive: true });
  toggleBackToTop();

  if(backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      if (window.lenis) {
        window.lenis.scrollTo(0, { 
          duration: 3.5,
          easing: (t) => 1 - Math.pow(1 - t, 4) 
        });
      } else if (!reduceMotion) {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        window.scrollTo(0, 0);
      }
    });
  }

})();
</script>

</body>
</html>