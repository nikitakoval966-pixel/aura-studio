---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>AURA — Креативна Студія</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script is:inline>
  const savedTheme = localStorage.getItem('theme');
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
</script>

<style is:global>
  :root {
    --bg:        #F5F5F7; 
    --bg-panel:  #FFFFFF; 
    --paper:     #1D1D1F; 
    --muted:     #86868B; 
    --accent:    #0071E3; 
    --line:      #E5E5EA; 
    --sans:      'Inter', sans-serif;
  }

  html[data-theme="dark"] {
    --bg:        #000000;
    --bg-panel:  #111111;
    --paper:     #F5F5F7;
    --muted:     #A1A1A6;
    --line:      #333336;
    --accent:    #2997FF;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  @media (hover: hover) and (pointer: fine) {
    *, a, button, .pill, .theme-btn, .bento-card, .step-card, .hero-widget, .back-to-top { cursor: none !important; }
  }

  body, .bento-card, .nav::before, footer, .marquee, .cta, .step-card {
    transition: background-color 0.5s ease, border-color 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;
  }

  html, body {
    width: 100%; max-width: 100vw; overflow-x: hidden;
    background: var(--bg); scroll-behavior: auto;
  }
  
  body {
    color: var(--paper); font-family: var(--sans); font-size: 16px; line-height: 1.6;
    -webkit-user-select: none; user-select: none;
    visibility: hidden; 
  }

  html { background: var(--bg); }

  a { color: inherit; text-decoration: none; display: inline-block; }
  img { display: block; max-width: 100%; object-fit: cover; pointer-events: none; }
  h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.03em; }

  .wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 768px) { .wrap { padding: 0 40px; } }

  /* ============ ШТОРКА ДЛЯ ТЕМЫ (ЧЕРНИЛА) ============ */
  html::view-transition-old(root),
  html::view-transition-new(root) {
    animation-duration: 0.8s;
    animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
    mix-blend-mode: normal;
  }
  html.theme-transitioning::view-transition-old(root) {
    z-index: 1;
    animation: none;
  }
  html.theme-transitioning::view-transition-new(root) {
    z-index: 2;
    animation: ink-fill 0.8s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  @keyframes ink-fill {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  .theme-wipe {
    position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
    z-index: 999999;
    background: #000;
    transform: translateY(-100%);
    pointer-events: none;
    will-change: transform;
  }

  #trailCanvas {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
  }

  @keyframes float {
    0% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(40px, -60px) scale(1.1); }
    66% { transform: translate(-30px, 30px) scale(0.9); }
    100% { transform: translate(0, 0) scale(1); }
  }

  /* ============ ГЛОБАЛЬНА СІТКА ============ */
  .global-grid {
    position: fixed; inset: 0; pointer-events: none; z-index: -1;
    background-size: 50px 50px;
    background-image:
      linear-gradient(to right, rgba(0, 113, 227, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 113, 227, 0.1) 1px, transparent 1px);
    -webkit-mask-image: radial-gradient(circle 0px at center, black 0%, transparent 100%);
    mask-image: radial-gradient(circle 0px at center, black 0%, transparent 100%);
  }
  html[data-theme="dark"] .global-grid {
    background-image:
      linear-gradient(to right, rgba(41, 151, 255, 0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(41, 151, 255, 0.15) 1px, transparent 1px);
  }

  .glow-circle {
    position: absolute; width: 60vw; height: 60vw; max-width: 600px; max-height: 600px;
    background: radial-gradient(circle, rgba(0,113,227,0.06) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%; filter: blur(60px); z-index: -3; pointer-events: none;
    animation: float 20s ease-in-out infinite;
  }
  .glow-1 { top: -5%; left: -10%; }
  .glow-2 { top: 40%; right: -20%; background: radial-gradient(circle, rgba(134,134,139,0.08) 0%, rgba(255,255,255,0) 70%); animation-delay: -10s; animation-duration: 25s; }

  html[data-theme="dark"] .glow-circle {
    background: radial-gradient(circle, rgba(41,151,255,0.12) 0%, rgba(0,0,0,0) 70%);
  }

  /* ============ КУРСОР ============ */
  .cursor {
    position: fixed; top: 0; left: 0; z-index: 9999; 
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--paper); 
    pointer-events: none; 
    visibility: visible; 
    transition: width .3s cubic-bezier(0.16, 1, 0.3, 1), height .3s cubic-bezier(0.16, 1, 0.3, 1), background .3s ease, border .3s ease;
    display: flex; align-items: center; justify-content: center;
  }
  
  .cursor.grow { 
    width: 64px; height: 64px; 
    background: rgba(0, 0, 0, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(0,0,0,0.1);
  }
  html[data-theme="dark"] .cursor.grow { 
    background: rgba(255, 255, 255, 0.1); 
    border: 1px solid rgba(255,255,255,0.2);
  }

  @media (pointer:coarse) { .cursor { display: none; } #trailCanvas { display: none; } }

  /* ============ ПРЕЛОАДЕР (СТРОГИЙ) ============ */
  .preloader {
    position: fixed; inset: 0; z-index: 9998;
    background: var(--bg); 
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    visibility: visible; 
    overflow: hidden;
  }

  .preloader-glow {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 40vw; height: 40vw; max-width: 500px; max-height: 500px;
    background: var(--accent);
    filter: blur(120px); border-radius: 50%;
    opacity: 0.3;
    animation: pulseAura 2.5s ease-in-out infinite alternate;
    pointer-events: none;
  }
  html[data-theme="dark"] .preloader-glow { opacity: 0.2; filter: blur(150px); }

  @keyframes pulseAura {
    0% { transform: translate(-50%, -50%) scale(0.8); opacity: 0.15; }
    100% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.4; }
  }
  
  .loader-brand {
    font-size: clamp(3.5rem, 12vw, 8rem);
    font-weight: 800; letter-spacing: -0.06em; line-height: 1;
    color: var(--paper); display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 2;
    will-change: transform, opacity;
  }

  .loader-brand::after {
    content: 'This Is Aura';
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 2s infinite linear;
    pointer-events: none;
    opacity: 0.5;
  }
  html[data-theme="light"] .loader-brand::after {
    background: linear-gradient(90deg, transparent, rgba(0,0,0,0.3), transparent);
    -webkit-background-clip: text;
  }

  @keyframes shimmer {
    0% { background-position: -100% 0; }
    100% { background-position: 200% 0; }
  }

  .loader-count {
    position: absolute; bottom: 40px; z-index: 2;
    font-size: 0.85rem; font-weight: 600; color: var(--muted); letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
  }

  /* ============ NAV ============ */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 150;
    border-bottom: 1px solid var(--line);
    isolation: isolate; 
  }
  
  .nav::before {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: rgba(245, 245, 247, 0.75);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
  }
  html[data-theme="dark"] .nav::before { background: rgba(0, 0, 0, 0.75); }
  
  .nav .wrap{ display:flex; align-items:center; justify-content:space-between; height: 60px; }
  .nav .brand{ font-size:1.1rem; font-weight:800; letter-spacing: -0.02em; flex-shrink: 0;}
  .nav .links{ display:flex; align-items: center; justify-content: flex-end; gap: 1.5rem; font-size:0.85rem; font-weight:600; color:var(--muted); }
  .nav .links a:hover, .nav .links button:hover{ color:var(--paper); transition: color 0.2s ease;}
  
  .controls { display: flex; align-items: center; gap: 1rem; margin-left: 1rem; border-left: 1px solid var(--line); padding-left: 1rem; }
  .lang-btn { text-transform: uppercase; font-weight: 700; transition: color 0.2s ease; }
  .lang-btn:hover { color: var(--paper); }
  
  .theme-btn {
    background: none; border: none; color: var(--paper); font-size: 1.2rem;
    transition: transform 0.2s ease; display: flex; align-items: center;
  }
  .theme-btn:hover { transform: scale(1.1); }

  .nav .links a.pill{
    background:var(--paper); color:var(--bg); border-radius:999px; padding:0.35rem 1rem; 
    transition: transform 0.2s ease; white-space: nowrap; flex-shrink: 0;
  }
  .nav .links a.pill:hover{ transform: scale(1.05); }
  @media (max-width:860px){ .nav .links > a:not(.pill, .lang-btn){ display:none; } .controls { margin-left: 0.5rem; padding-left: 0.5rem; } }

  /* ============ HERO (ВИПРАВЛЕНО ВЕРСТКУ) ============ */
  .hero { 
    min-height: 80svh; display:flex; flex-direction:column; justify-content:center; 
    padding-top: 6rem; position:relative;
  }
  
  .hero-wrap { 
    display: flex; align-items: center; justify-content: space-between; 
    gap: 3rem; flex-wrap: wrap; position: relative; z-index: 1; 
  }

  /* flex-basis: 480px гарантує, що текст не стискатиметься до 4-х рядків. Якщо місця мало - віджет впаде вниз */
  .hero-text { flex: 1 1 480px; min-width: 300px; } 
  .hero .eyebrow { font-size:0.95rem; font-weight:600; color:var(--muted); margin-bottom:1.5rem; }
  
  .hero h1 { font-size: clamp(2.5rem, 6.5vw, 6rem); line-height: 1.05; font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem; }
  .hero .sub { margin-top:1.5rem; max-width:48ch; font-size: clamp(1rem, 2vw, 1.1rem); font-weight:500; color:var(--muted); opacity:0; transform:translateY(16px); }

  /* ============ ВІДЖЕТ ============ */
  .hero-widget {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(40px) saturate(200%);
    -webkit-backdrop-filter: blur(40px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 32px;
    padding: 2.5rem 2rem;
    flex: 0 0 auto; /* Віджет не стискається */
    min-width: 380px; 
    box-shadow: 0 30px 60px rgba(0, 113, 227, 0.1), inset 0 1px 0 rgba(255,255,255,0.8);
    opacity: 0; transform: translateY(30px) scale(0.95);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  html[data-theme="dark"] .hero-widget {
    background: rgba(30, 30, 32, 0.4);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255,255,255,0.05);
  }
  .hero-widget:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 40px 80px rgba(0, 113, 227, 0.15), inset 0 1px 0 rgba(255,255,255,0.8);
    border-color: rgba(0, 113, 227, 0.3);
  }
  html[data-theme="dark"] .hero-widget:hover { box-shadow: 0 40px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1); }

  .widget-row { 
    display: flex; align-items: center; justify-content: space-between; 
    gap: 2rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line); 
    font-size: 0.95rem; font-weight: 600;
  }
  .widget-row:last-child { border-bottom: none; padding-bottom: 0; }
  .widget-row:first-child { padding-top: 0; }

  .status-badge { display: flex; align-items: center; gap: 10px; color: var(--paper); font-weight: 700; letter-spacing: -0.02em;}
  .status-badge .dot { width: 10px; height: 10px; background: #34C759; border-radius: 50%; box-shadow: 0 0 12px #34C759; animation: pulse 2s infinite; }
  @keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1); } }

  .widget-label { color: var(--paper); white-space: nowrap; flex-shrink: 0; }
  .widget-value { color: var(--muted); white-space: nowrap; text-align: right; }
  .time-value { background: var(--paper); color: var(--bg-panel); padding: 0.2rem 0.6rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700; }

  @media (max-width: 860px) {
    .hero-widget { min-width: 100%; width: 100%; padding: 1.5rem; }
    .widget-row { gap: 1rem; padding: 1rem 0; font-size: 0.85rem; }
    .hero-wrap { gap: 2rem; }
  }

  /* ============ MARQUEE ============ */
  .marquee { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(1rem, 3vw, 1.5rem) 0; overflow: hidden; background: var(--bg-panel); margin-top: clamp(3rem, 8vw, 6rem); width: 100%; }
  .marquee .track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .marquee .content { display: flex; align-items: center; flex-wrap: nowrap; gap: clamp(2rem, 5vw, 4rem); padding-right: clamp(2rem, 5vw, 4rem); font-size: clamp(1.1rem, 3vw, 1.3rem); font-weight: 700; color: var(--paper); }
  .marquee .dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; flex-shrink: 0; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* ============ MANIFESTO ============ */
  .manifesto { padding: clamp(5rem, 10vw, 10rem) 0; text-align: center; position: relative; }
  .manifesto .tag { display: inline-block; padding: 0.4rem 1.2rem; border-radius: 999px; background: var(--line); color: var(--paper); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2.5rem; }
  .manifesto p.quote { font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: 1.2; font-weight: 700; letter-spacing: -0.03em; max-width: 24ch; margin: 0 auto; }
  .manifesto p.quote .word { opacity: 0.2; transition: opacity .15s ease-out; }
  .manifesto p.quote .word.lit { opacity: 1; }
  .manifesto .desc { margin: 2rem auto 0; max-width: 52ch; color: var(--muted); font-size: clamp(1rem, 2vw, 1.1rem); font-weight: 500; }

  /* ============ BENTO GRID ============ */
  .bento { padding: clamp(4rem, 8vw, 6rem) 0; }
  .bento .head { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .bento .head h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 0.5rem; }
  
  .bento-grid { 
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; 
    perspective: 1200px;
  }
  
  .bento-card { 
    background: var(--bg-panel); border-radius: 32px; padding: clamp(1.5rem, 4vw, 2.5rem); 
    box-shadow: 0 4px 24px rgba(0,0,0,0.03); border: 1px solid var(--line); 
    display: flex; flex-direction: column; justify-content: flex-start; 
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease; 
    transform-style: preserve-3d;
  }
  
  .bento-card:hover { 
    transform: translateY(-12px) scale(1.04) rotateX(6deg) rotateY(-3deg); 
    box-shadow: -12px 24px 48px rgba(0, 0, 0, 0.08), 0 8px 16px rgba(0, 113, 227, 0.08); 
    border-color: rgba(0, 113, 227, 0.3); 
    z-index: 10;
  }
  
  .bento-card svg { width: 40px; height: 40px; margin-bottom: 1.5rem; fill: var(--accent); transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .bento-card:hover svg { transform: translateZ(30px) scale(1.15); }
  
  .bento-card h3 { font-size: 1.3rem; margin-bottom: 0.8rem; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .bento-card:hover h3 { transform: translateZ(20px); }
  
  .bento-card p { color: var(--muted); font-size: 0.95rem; font-weight: 500; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  .bento-card:hover p { transform: translateZ(10px); }

  @media (max-width: 900px) { .bento-grid { grid-template-columns: 1fr; } }

  /* ============ ПРОЦЕС ============ */
  .process { padding: clamp(5rem, 10vw, 10rem) 0; position: relative; }
  .process .wrap { display: grid; grid-template-columns: 0.8fr 1.5fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  
  .process-info { position: sticky; top: 120px; }
  .process-info h2 { font-size: clamp(2.2rem, 4vw, 3.6rem); margin-bottom: 1rem; line-height: 1.1; }
  .process-info p { color: var(--muted); font-size: 1rem; font-weight: 500; max-width: 30ch; }
  
  .core-wrapper { perspective: 1000px; margin-top: 3rem; display: flex; align-items: center; } 
  
  @media (max-width: 900px) { 
    .process .wrap { grid-template-columns: 1fr; gap: 3rem; } 
    .process-info { text-align: center; display: flex; flex-direction: column; align-items: center; }
    .process-info p { text-align: center; }
    .core-wrapper { margin-top: 2rem; justify-content: center; width: 100%; } 
  }

  .aura-core {
    width: 100px; height: 100px; position: relative; transform-style: preserve-3d;
    animation: spinCore 15s linear infinite;
  }
  .aura-core .ring {
    position: absolute; inset: 0; border: 1px solid rgba(0, 113, 227, 0.4); border-radius: 50%;
    box-shadow: 0 0 15px rgba(0, 113, 227, 0.1), inset 0 0 15px rgba(0, 113, 227, 0.1);
  }
  html[data-theme="dark"] .aura-core .ring { border-color: rgba(41,151,255, 0.4); box-shadow: 0 0 15px rgba(41,151,255, 0.1), inset 0 0 15px rgba(41,151,255, 0.1); }
  
  .aura-core .ring:nth-child(1) { transform: rotateY(0deg); }
  .aura-core .ring:nth-child(2) { transform: rotateY(60deg); }
  .aura-core .ring:nth-child(3) { transform: rotateY(120deg); }
  .aura-core .ring:nth-child(4) { transform: rotateX(90deg); }
  @keyframes spinCore {
    0% { transform: rotateX(20deg) rotateY(0deg); }
    100% { transform: rotateX(20deg) rotateY(360deg); }
  }

  .process-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; perspective: 1200px; }
  @media (max-width: 600px) { .process-grid { grid-template-columns: 1fr; } }
  
  .step-no { font-size: 0.85rem; font-weight: 700; color: var(--accent); letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem; transition: transform 0.4s ease; }
  .bento-card:hover .step-no { transform: translateZ(20px); }

  /* ============ CTA ============ */
  .cta{ padding:clamp(5rem,12vw,9rem) 0; text-align:left; background:var(--bg-panel); border-radius: 40px 40px 0 0;}
  .cta .label{ color:var(--muted); font-size:1rem; font-weight:700; margin-bottom:1.2rem; text-transform:uppercase; letter-spacing:0.05em;}
  .cta a.email{ font-weight:800; letter-spacing: -0.04em; font-size:clamp(1.5rem, 8vw, 4rem); word-break:break-word; display:inline-block; position:relative; color: var(--paper); }
  .cta a.email::after{ content:''; position:absolute; left:0; bottom:0.1em; width:100%; height:4px; background:var(--accent); transform:scaleX(0); transform-origin:left; transition:transform .4s ease; }
  .cta a.email:hover::after{ transform:scaleX(1); }
  .cta .details{ margin-top:clamp(2.5rem, 6vw, 3.5rem); display:flex; gap: clamp(2rem, 5vw, 4rem); color:var(--muted); font-size:0.95rem; font-weight:500; flex-wrap:wrap; }
  .cta .details b{ color:var(--paper); display:block; font-weight:700; margin-bottom:0.4rem; text-transform:uppercase; font-size:0.8rem; letter-spacing:0.05em;}

  /* ============ FOOTER ============ */
  footer{ border-top: 1px solid var(--line); padding-top: 2.5rem; padding-bottom: calc(2.5rem + env(safe-area-inset-bottom)); background: var(--bg-panel); }
  footer .wrap{ display:flex; justify-content:space-between; align-items:center; font-size:0.9rem; font-weight:600; color:var(--muted); flex-wrap:wrap; gap:1.5rem; }
  footer .socials{ display:flex; gap:1.5rem; }
  footer .socials a:hover{ color:var(--paper); }

  .reveal-slow { visibility: hidden; }

  /* ============ КНОПКА "НАВЕРХ" ============ */
  .back-to-top {
    position: fixed;
    right: clamp(16px, 4vw, 32px);
    bottom: clamp(16px, 4vw, 32px);
    z-index: 140;
    width: 52px; height: 52px;
    border: none; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    color: var(--paper);
    opacity: 0;
    transform: translateY(24px) scale(0.85);
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  html[data-theme="dark"] .back-to-top {
    background: rgba(20, 20, 22, 0.6);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
  }
  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .back-to-top:hover {
    transform: translateY(-4px) scale(1.06);
    box-shadow: 0 18px 36px rgba(0, 113, 227, 0.2);
    border-color: rgba(0, 113, 227, 0.35);
  }
  .back-to-top svg {
    width: 20px; height: 20px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .back-to-top:hover svg { transform: translateY(-2px); }

  @media (pointer: coarse) {
    .back-to-top { width: 48px; height: 48px; }
  }
</style>
